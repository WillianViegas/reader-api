@reader_api_HostAddress = http://localhost:5094

GET {{reader_api_HostAddress}}/weatherforecast/
Accept: application/json

###

@readerToken = replace-with-access-token
@savedTranslationId = replace-with-guid

### Save a translation to the authenticated user's vocabulary
POST {{reader_api_HostAddress}}/api/vocabulary
Authorization: Bearer {{readerToken}}
Content-Type: application/json

{
	"originalText": "Good morning, how are you?",
	"translatedText": "Bom dia, como você está?",
	"sourceLanguage": "en",
	"targetLanguage": "pt-BR",
	"contextText": "Good morning, how are you?",
	"mangaExternalId": "manga-id",
	"mangaTitle": "Manga title",
	"chapterExternalId": "chapter-id",
	"chapterTitle": "Chapter 1",
	"pageNumber": 12
}

### List saved translations for the authenticated user
GET {{reader_api_HostAddress}}/api/vocabulary?page=1&pageSize=50
Authorization: Bearer {{readerToken}}
Accept: application/json

### Get a saved translation
GET {{reader_api_HostAddress}}/api/vocabulary/{{savedTranslationId}}
Authorization: Bearer {{readerToken}}
Accept: application/json

### Delete a saved translation
DELETE {{reader_api_HostAddress}}/api/vocabulary/{{savedTranslationId}}
Authorization: Bearer {{readerToken}}

### Proxy one MangaDex chapter image through the Reader API for canvas/OCR
GET {{reader_api_HostAddress}}/api/catalog/chapters/{{chapterId}}/pages/0
Accept: image/jpeg

### Import a PDF into the authenticated user's library (maximum 100 MB)
POST {{reader_api_HostAddress}}/api/library/pdfs
Authorization: Bearer {{readerToken}}
Content-Type: multipart/form-data; boundary=pdf-boundary

--pdf-boundary
Content-Disposition: form-data; name="title"

My book
--pdf-boundary
Content-Disposition: form-data; name="file"; filename="book.pdf"
Content-Type: application/pdf

< ./book.pdf
--pdf-boundary--

### Read a PDF from the authenticated user's library
GET {{reader_api_HostAddress}}/api/library/pdfs/{{pdfId}}
Authorization: Bearer {{readerToken}}
Accept: application/pdf

### Read a PDF cover (JPEG generated from the first page)
GET {{reader_api_HostAddress}}/api/library/pdfs/{{pdfId}}/cover
Authorization: ******

### Save reading progress of an imported PDF
PUT {{reader_api_HostAddress}}/api/library/pdfs/{{pdfId}}/progress
Authorization: ******
Content-Type: application/json

{ "currentPage": 3, "pageCount": 120 }

### Get reading progress of an imported PDF
GET {{reader_api_HostAddress}}/api/library/pdfs/{{pdfId}}/progress
Authorization: ******

### Remove an imported PDF
DELETE {{reader_api_HostAddress}}/api/library/pdfs/{{pdfId}}
Authorization: Bearer {{readerToken}}
